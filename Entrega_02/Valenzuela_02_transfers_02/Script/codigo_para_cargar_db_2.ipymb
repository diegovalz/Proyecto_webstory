      "source": [
        "# Script de carga y verificación de la base de datos limpia\n",
        "# Proyecto: Radiografía al Sobreprecio e Inflación en la Premier League (2010-2026)\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Cargar el archivo CSV limpio indicando el separador de punto y coma\n",
        "archivo = \"Transfers_cleaned2.csv\"\n",
        "df = pd.read_csv(archivo, sep=';', encoding='utf-8')\n",
        "\n",
        "# 2. Información estructural del dataset\n",
        "print(\"--- ESTRUCTURA DE LA BASE DE DATOS LIMPIA ---\")\n",
        "df.info()\n",
        "\n",
        "# 3. Visualizar las primeras 5 filas\n",
        "print(\"\\n--- PRIMERAS 5 FILAS ---\")\n",
        "df.head()"
